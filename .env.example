# Copie para .env e ajuste se necessário. Nenhuma credencial é exigida nesta etapa.
# Variáveis vazias ou ausentes usam o padrão indicado.

# --- API do IpeaData ---
IPEA_BASE_URL=https://www.ipeadata.gov.br/api/odata4/
# Timeouts em segundos (a série municipal completa leva 30-45 s para chegar)
IPEA_TIMEOUT_CONEXAO=10
IPEA_TIMEOUT_LEITURA=180
# Tentativas extras para falhas transitórias (rede, download truncado, HTTP 429/5xx)
IPEA_MAX_TENTATIVAS=3
# Backoff exponencial: 2, 4, 8 s... respeitando Retry-After, limitado ao máximo
IPEA_BACKOFF_SEGUNDOS=2
IPEA_BACKOFF_MAXIMO_SEGUNDOS=300
# Intervalo mínimo entre requisições (limite de taxa, vale também entre threads)
IPEA_INTERVALO_MINIMO_SEGUNDOS=1

# --- Coleta ---
# full = carga histórica completa | incremental = atualização (usado por main.py)
COLETA_MODO=full
# UF de interesse (sigla)
UF_INTERESSE=MA
# Registros por lote no processamento em fluxo
COLETA_TAMANHO_LOTE=50000
# Downloads simultâneos. 1 = sequencial (recomendado: poucas requisições grandes num servidor público)
COLETA_MAX_CONCORRENCIA=1
# Quantidade oficial de municípios a conferir (padrão: 217 para MA)
TOTAL_MUNICIPIOS_ESPERADO=

# --- Atualização incremental ---
# Revisões nos últimos N meses do snapshot são aplicadas
INCREMENTAL_JANELA_MESES=12
# 1 = aplica também revisões mais antigas que a janela; 0 = só registra
INCREMENTAL_APLICAR_REVISOES_FORA_JANELA=0

# --- Validação territorial ---
# estrita = interrompe a coleta se a lista oficial do IBGE e o cadastro do IpeaData divergirem
# alerta  = registra a divergência e continua
VALIDACAO_TERRITORIAL=estrita
IBGE_TIMEOUT=30

# --- Logs --- (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Testes ---
# 1 = roda também os testes que acessam as APIs reais
IPEA_TESTES_INTEGRACAO=0
# 1 = inclui o teste que baixa a série municipal completa (~64 MB)
IPEA_TESTES_LENTOS=0

# --- PostgreSQL (etapa 2) ---
# Copie para .env e defina uma senha própria. NUNCA versione o .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=emprego
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=emprego_maranhao
# Banco isolado para os testes automatizados (precisa terminar em _test)
POSTGRES_TEST_DB=emprego_maranhao_test
POSTGRES_TIMEOUT_CONEXAO=10
# Alternativas: URLs SQLAlchemy completas (têm precedência sobre POSTGRES_*)
DATABASE_URL=
TEST_DATABASE_URL=
# Linhas por lote na leitura dos arquivos durante a importação
IMPORTACAO_TAMANHO_LOTE=5000

# --- PostgreSQL sem Docker (scripts.postgres_local) ---
# Padrão: %LOCALAPPDATA%\emprego-maranhao\pg17\pgsql\bin e %LOCALAPPDATA%\emprego-maranhao\pgdata
PG_BIN_DIR=
PG_DATA_DIR=
